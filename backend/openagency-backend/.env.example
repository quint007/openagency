# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional alpha-stage HTTP Basic Auth gate. Set both values to enable.
ALPHA_BASIC_AUTH_USERNAME=
ALPHA_BASIC_AUTH_PASSWORD=

# Used to configure CORS, format links and more. No trailing slash
# This should be the backend/admin origin in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Resend email provider API key and confirmed-subscriber audience
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_AUDIENCE_ID=YOUR_RESEND_AUDIENCE_ID_HERE

# Shared only with the marketing server for narrow newsletter API calls
NEWSLETTER_SERVICE_SECRET=YOUR_NEWSLETTER_SERVICE_SECRET_HERE
# Fail-closed production collection switch and durable unsubscribe-token key
NEWSLETTER_ENABLED=false
NEWSLETTER_WITHDRAWAL_REQUIRED=false
NEWSLETTER_PRIVACY_VERSION=
NEWSLETTER_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BASE64URL_ENCODED_BYTES

# Used for frontend app revalidation delivery
# These remain the canonical public site URLs for Payload resource links.
MARKETING_APP_BASE_URL=http://localhost:3000
COURSES_APP_BASE_URL=http://localhost:3001
# Optional: override the machine-to-machine revalidation target when the public
# hostname sits behind Cloudflare or another proxy. No trailing slash.
MARKETING_REVALIDATE_URL=
COURSES_REVALIDATE_URL=
REVALIDATE_SECRET=YOUR_REVALIDATE_SECRET_HERE
# Optional, defaults to 5000
REVALIDATE_TIMEOUT_MS=5000

# Cloudflare R2 media storage (S3-compatible)
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
# Do not append the bucket name to R2_ENDPOINT; keep R2_BUCKET separate.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=open-agency-production-media
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# Public read URL for media, ideally a custom domain in production
R2_PUBLIC_BASE_URL=https://media.example.com
# Optional, defaults to auto for R2
R2_REGION=auto

# API keys for the api-clients collection (used by MCP plugin and direct API access)
# Generate keys via the Payload admin panel under the Api Clients collection
