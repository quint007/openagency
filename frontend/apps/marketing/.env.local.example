NODE_ENV=development
PORT=3000
PAYLOAD_API_URL=http://localhost:3002/api
PAYLOAD_API_KEY=
REVALIDATE_SECRET=replace-with-server-only-revalidation-secret
ALPHA_BASIC_AUTH_USERNAME=
ALPHA_BASIC_AUTH_PASSWORD=
# Resend API key used only by the feedback fallback in this app.
RESEND_API_KEY=
# Server-only credential shared with the Payload newsletter endpoints.
NEWSLETTER_SERVICE_SECRET=
# Public UI switch. Production defaults to closed unless explicitly enabled.
NEXT_PUBLIC_NEWSLETTER_ENABLED=true
# Notion integration token for storing feedback submissions (required for feedback to work)
NOTION_TOKEN=
# Notion database ID where feedback pages are created (required for feedback to work)
NOTION_FEEDBACK_DATABASE_ID=
# Optional Google Analytics measurement ID. Analytics loads only after visitor consent.
NEXT_PUBLIC_GA_ID=
# Optional Google AdSense client ID. Advertising loads only after visitor consent.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
