{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "ALPHA_BASIC_AUTH_PASSWORD",
        "ALPHA_BASIC_AUTH_USERNAME",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_ADSENSE_CLIENT_ID",
        "NEXT_PUBLIC_GA_ID",
        "NEXT_PUBLIC_NEWSLETTER_ENABLED",
        "NEXT_PUBLIC_SERVER_URL",
        "NOTION_FEEDBACK_DATABASE_ID",
        "NOTION_TOKEN",
        "PAYLOAD_API_URL",
        "REVALIDATE_SECRET",
        "RESEND_API_KEY",
        "NEWSLETTER_SERVICE_SECRET"
      ],
      "cache": true,
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.css", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
